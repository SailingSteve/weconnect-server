model Person {
  id Int @id @default(autoincrement())

  birthdayMonthAndDay    String?
  emailOfficial          String? // We have to manually enforce uniqueness, since prisma won't allow @unique with null values
  emailOfficialAlternate String?
  emailOfficialVerified  Boolean? // Email has been created and verified
  emailPersonal          String   @unique
  emailPersonalOkToShare Boolean? // Volunteer approves sharing personal email with other WeVote volunteers
  emailPersonalAlternate String?
  emailPreferred         String?  // This must always be identical to emailOfficial or emailPersonal, or will be null -- We have to manually enforce uniqueness, since allow @unique with null values
  firstName              String
  firstNamePreferred     String?
  gender                 String?
  hoursPerWeekEstimate   Int?
  /// Estimate of total hours volunteered
  hoursVolunteered       Int?
  /// Stored as number of days, but displayed in years, months & weeks
  howLongAtOrg           Int?
  jobTitle               String?
  lastName               String?
  /// location is City, State -- not full address
  location               String?
  /// c3 / c4
  staffKind              String?
  stateCode              String?
  uploadedImageUrlLarge  String?
  uploadedImageUrlSmall  String?
  zipCode                String?

  password               String?
  passwordResetToken     String?
  passwordResetExpires   DateTime?
  emailVerificationToken String?
  emailVerified          Boolean?

  bluesky       String?
  facebookUrl   String?
  githubUrl     String?
  jazzHrUrl     String?
  linkedInUrl   String?
  portfolioUrl  String?
  snapchat      String?
  // tokens        Json?
  twitch        String?
  twitterHandle String?
  websiteUrl    String?

  dateCreated                       DateTime  @default(now())
  dateEmailCreated                  DateTime?
  /// Date they ended service, or for interns, the planned end date
  dateEndDate                       DateTime?
  dateLastActive                    DateTime?
  dateLastOnLeave                   DateTime?
  dateLastUpdated                   DateTime  @default(now()) @updatedAt
  dateLastResigned                  DateTime?
  dateOfferLetterCreated            DateTime?
  dateOfferLetterSigned             DateTime?
  dateStartDate                     DateTime?
  /// This person has admin rights
  isAdmin                           Boolean?
  isHRAdmin                         Boolean?
  isHROfferAdmin                    Boolean?
  /// Has HR Generalist rights
  isHRGeneralist1                   Boolean?
  isHRGeneralist2                   Boolean?
  /// Has hiring manager rights
  isHiringManager                   Boolean?
  isIntern                          Boolean?
  /// Has team lead rights
  isTeamLead                        Boolean?
  statusActive                      Boolean?
  /// They are no longer active, but might be available for special projects
  statusAvailableForSpecialProjects Boolean?
  /// Hiring manager does not think this is a suitable candidate
  statusEmailCreated                Boolean?
  statusActiveInLast90Days          Boolean?
  /// Person has stopped responding to inquiries, so we assume they are resigned
  statusNonresponsive               Boolean?
  statusOfferLetterCreated          Boolean?
  statusOfferLetterSigned           Boolean?
  statusOfferDecisionNeeded         Boolean   @default(false)
  /// Hiring manager would like an offer sent to this person
  statusOfferApproved               Boolean?
  /// Hiring manager does not think this is a suitable candidate
  statusOfferWillNotBeMade          Boolean?
  /// Person notified us they are on leave
  statusOnLeave                     Boolean?
  /// Person notified us they have resigned
  statusResigned                    Boolean?
  importNote                        String?
  // nonAuthoritativeImport === true, means that while importing from csv, so that we can build the team while proceeding down the sheet
  // knowing that we will replace them with the authoritative copy when we encounter them.  This is in the DB in case the import crashes and we lose track
  nonAuthoritativeImport            Boolean   @default(false)

  QuestionAnswer QuestionAnswer[]
  TeamMember     TeamMember[]
}

model PersonAway {
  id                          Int       @id @default(autoincrement())
  awayDescription             String?
  awayDescriptionForTeamLeads String?
  dateEndDate                 DateTime?
  dateEndDateEstimated        DateTime?
  dateStartDate               DateTime  @default(now())
  dateSubmitted               DateTime  @default(now())
  personId                    Int
  reportedByPersonId          Int?

  // Only one of these is meant to be checked at a time
  isLeaveOfAbsence Boolean?
  isNotFeelingWell Boolean?
  isNonResponsive  Boolean?
  isNotAttending   Boolean?
  isResigned       Boolean?
  isVacation       Boolean?
  isWorkTrip       Boolean?
}
